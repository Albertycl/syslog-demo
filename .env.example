# Copy to .env and set your own values. Never commit .env.
# Option A: your own MariaDB/MySQL (create the database first):
DATABASE_URL=mysql+pymysql://root:CHANGEME@your-db-host:3306/syslog_demo
# Option B: the bundled database (docker compose --profile db up):
#   MYSQL_ROOT_PASSWORD=CHANGEME
#   DATABASE_URL=mysql+pymysql://root:CHANGEME@mariadb:3306/syslog_demo

# Demo collector: every N seconds it reads fake logs from the last M minutes (0 = off)
COLLECT_INTERVAL_SECONDS=20
COLLECT_WINDOW_MINUTES=5
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:8090
